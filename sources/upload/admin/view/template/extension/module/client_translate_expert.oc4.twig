{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-bestseller" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-bs-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-secondary"><i class="fa fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    {% endif %}
    <div class="card">
      <div class="card-header">
        <h3 class="card-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="card-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-bestseller">
          <ul class="nav nav-tabs">
            <li class="nav-item"><a href="#tab-general" class="nav-link {{ tab_general_class }}" data-bs-toggle="tab">{{ tab_general }}</a></li>
            <li class="nav-item"><a href="#tab-translate-site" class="nav-link" data-bs-toggle="tab">{{ tab_translate_site }}</a></li>
            <li class="nav-item"><a href="#tab-localization" class="nav-link" data-bs-toggle="tab">{{ tab_localization }}</a></li>
            <li class="nav-item"><a href="#tab-admin-localization" class="nav-link" data-bs-toggle="tab">{{ tab_admin_localization }}</a></li>
            <li class="nav-item"><a href="#tab-debug" class="nav-link {{ tab_debug_class }}" data-bs-toggle="tab">{{ tab_debug }}</a></li>
            <li class="nav-item"><a href="#tab-about" class="nav-link" data-bs-toggle="tab">{{ tab_about }}</a></li>
          </ul>

          <div class="tab-content">
            <div class="tab-pane {{ tab_general_class }}" id="tab-general">
              <div class="mb-3 row">
                <label class="col-sm-2 form-label" for="input-client_translate_expert_status">{{ entry_status }}</label>
                <div class="col-sm-10">
                  <select name="client_translate_expert_status" id="input-client_translate_expert_status" class="form-select">
                    {% if client_translate_expert_status %}
                    <option value="1" selected="selected">{{ text_enabled }}</option>
                    <option value="0">{{ text_disabled }}</option>
                    {% else %}
                    <option value="1">{{ text_enabled }}</option>
                    <option value="0" selected="selected">{{ text_disabled }}</option>
                    {% endif %}
                  </select>
                </div>
              </div>
              <div class="mb-3 row">
                <label class="col-sm-2 form-label" for="input-client_translate_expert_key">{{ entry_server_key }}</label>
                <div class="col-sm-10">
                  <style>.te-key-masked { -webkit-text-security: disc; }</style>
                  <div class="input-group">
                    <input type="text" autocomplete="off" spellcheck="false" data-lpignore="true" data-1p-ignore="true" data-bwignore="true" data-form-type="other" name="client_translate_expert_key" value="{{ client_translate_expert_key }}" placeholder="{{ entry_server_key }}" id="input-client_translate_expert_key" class="form-control te-key-masked" />
                    <button type="button" id="button-client_translate_expert_key_toggle" class="btn btn-outline-secondary" data-text-show="{{ button_show_key }}" data-text-hide="{{ button_hide_key }}">{{ button_show_key }}</button>
                  </div>
                  {% if error_name %}
                  <div class="text-danger">{{ error_name }}</div>
                  {% endif %}
                </div>
              </div>
              <div class="mb-3 row">
                <label class="col-sm-2 form-label" for="te-cron-bulk-amount">{{ entry_cron_bulk_amount }}</label>
                <div class="col-sm-10">
                  <input type="number" min="1" max="100000" step="1" name="client_translate_expert_cron_bulk_amount" value="{{ client_translate_expert_cron_bulk_amount|e('html_attr') }}" id="te-cron-bulk-amount" class="form-control" />
                  <div class="form-text">{{ help_cron_bulk_amount }}</div>
                </div>
              </div>
              <div class="mb-3 row">
                <label class="col-sm-2 form-label" for="te-cron-secret">{{ entry_cron_secret }}</label>
                <div class="col-sm-10">
                  <div class="input-group">
                    <input type="text" autocomplete="off" spellcheck="false" data-lpignore="true" data-1p-ignore="true" data-bwignore="true" data-form-type="other" maxlength="128" name="client_translate_expert_cron_secret" value="{{ client_translate_expert_cron_secret|e('html_attr') }}" placeholder="{{ entry_cron_secret }}" id="te-cron-secret" class="form-control" />
                    <button type="button" id="te-cron-secret-generate" class="btn btn-outline-secondary">{{ button_cron_secret_generate }}</button>
                  </div>
                  <div class="form-text">{{ help_cron_secret }}</div>
                  <div class="text-warning" id="te-cron-secret-unsaved" style="display:none">{{ text_cron_secret_unsaved }}</div>
                </div>
              </div>
              <div class="mb-3 row">
                <label class="col-sm-2 form-label" for="input-client_translate_expert_show_char_count_globally">{{ entry_server_show_translation_char_count_globally }}</label>
                <div class="col-sm-10">
                  <input type="checkbox" name="client_translate_expert_show_char_count_globally" value="1" id="input-client_translate_expert_show_char_count_globally" class="form-check-input" {% if client_translate_expert_show_char_count_globally == 1 %}checked="checked"{% endif %}/> {{ entry_server_show_translation_char_count_globally }}
                </div>
              </div>
              <div class="mb-3 row">
                <label class="col-sm-2 form-label" for="input-client_translate_expert_reset_char_count_on_start_month">{{ entry_server_reset_translation_char_count_on_start_month }}</label>
                <div class="col-sm-10">
                  <input type="checkbox" name="client_translate_expert_reset_char_count_on_start_month" value="1" id="input-client_translate_expert_reset_char_count_on_start_month" class="form-check-input" {% if client_translate_expert_reset_char_count_on_start_month == 1 %}checked="checked"{% endif %} /> {{ entry_server_reset_translation_char_count_on_start_month }}
                </div>
              </div>
              <div class="mb-3 row">
                <label class="col-sm-2 form-label" for="input-client_translate_expert_char_count">{{ entry_server_translation_char_count }}</label>
                <div class="col-sm-10">
                  <div id="input-client_translate_expert_char_count">
                    {{ client_translate_expert_char_count ? client_translate_expert_char_count : 0 }}
                  </div>
                </div>
              </div>
              <div class="mb-3 row">
                <label class="col-sm-2 form-label" for="input-client_translate_expert_excluded_routes">{{ entry_excluded_routes }}</label>
                <div class="col-sm-10">
                  <textarea name="client_translate_expert_excluded_routes" rows="5" id="input-client_translate_expert_excluded_routes" class="form-control">{{ client_translate_expert_excluded_routes }}</textarea>
                  <div class="form-text">{{ help_excluded_routes }}</div>
                </div>
              </div>
              <div class="mb-3 row">
                <label class="col-sm-2 form-label">{{ entry_try_translate }}</label>
                <div class="col-sm-10">
                  {% for language in languages %}
                  <div class="input-group mb-2">
                    <span class="input-group-text"><img src="{{ language.image_url }}" title="{{ language.name }}" /></span>
                    <textarea name="test[{{ language.language_id }}][translation]" rows="7" placeholder="{{ entry_try_translate_text }}" class="form-control"></textarea>
                  </div>
                  {% endfor %}
                </div>
              </div>
            </div>
            <div class="tab-pane" id="tab-translate-site">
              <div class="mb-3 row">
                <label class="col-sm-2 form-label" for="te-analization-mode">{{ entry_analization_mode }}</label>
                <div class="col-sm-10">
                  <select id="te-analization-mode" class="form-select">
                    <option value="both" {% if te_mode == 'both' %}selected="selected"{% endif %}>{{ value_analization_mode_both }}</option>
                    <option value="only_empty" {% if te_mode == 'only_empty' %}selected="selected"{% endif %}>{{ value_analization_mode_only_empty }}</option>
                    <option value="same_value" {% if te_mode == 'same_value' %}selected="selected"{% endif %}>{{ value_analization_mode_same_value }}</option>
                  </select>
                </div>
              </div>
              <div class="mb-3 row">
                <label class="col-sm-2 form-label" for="te-analization-table">{{ entry_table }}</label>
                <div class="col-sm-10">
                  <div class="mb-1"><button type="button" class="btn btn-outline-secondary btn-sm te-multi-select-all" data-te-target="#te-analization-table" data-te-caption-first="{{ button_select_first|e('html_attr') }}">{{ button_select_all }}</button> <button type="button" class="btn btn-outline-secondary btn-sm te-multi-select-clear" data-te-target="#te-analization-table">{{ button_clear_selection }}</button></div>
                  <select id="te-analization-table" data-te-max="{{ te_multi_select_max }}" multiple="multiple" size="6" class="form-select">
                    {% for table in tables %}
                    <option value="{{ table }}" {% if table in te_table %}selected="selected"{% endif %}>{{ table }}</option>
                    {% endfor %}
                  </select>
                  <div class="form-text">{{ help_multi_select }}</div><div class="form-text te-multi-select-limit" style="display:none">{{ help_multi_select_limit }}</div>
                </div>
              </div>
              <div class="mb-3 row">
                <label class="col-sm-2 form-label" for="te-analization-language-from">{{ entry_analization_language_from }}</label>
                <div class="col-sm-10">
                  <select id="te-analization-language-from" class="form-select">
                    {% for language in languages %}
                    <option value="{{ language.language_id }}" {% if te_langIdFrom == language.language_id %}selected="selected"{% endif %}>{{ language.name }}</option>
                    {% endfor %}
                  </select>
                </div>
              </div>
              <div class="mb-3 row">
                <label class="col-sm-2 form-label" for="te-analization-language-to">{{ entry_analization_language_to }}</label>
                <div class="col-sm-10">
                  <select id="te-analization-language-to" class="form-select" onchange="$('#te-begin-removing_data_from_db').val('{{ entity_begin_removing_data_from_db }} - ' + this.options[this.selectedIndex].text)">
                    {% for language in languages %}
                    <option value="{{ language.language_id }}" {% if (te_langIdTo is empty and loop.index0 == 1) or (te_langIdTo is not empty and te_langIdTo == language.language_id) %}selected="selected"{% endif %}>{{ language.name }}</option>
                    {% endfor %}
                  </select>
                </div>
              </div>
              <div class="mb-3 row">
                <label class="col-sm-2 form-label" for="te-analization-table-deep">{{ entry_table_deep }}</label>
                <div class="col-sm-10">
                  <input type="checkbox" id="te-analization-table-deep" value="1" checked="checked" class="form-check-input"> {{ entry_table_deep_description }}
                </div>
              </div>

              <div class="mb-3 row">
                <label class="col-sm-2 form-label" for="te-analization-product-status-filter">{{ entry_table_product_filter }}</label>
                <div class="col-sm-10">
                  <input type="checkbox" id="te-analization-product-status-filter" value="1" class="form-check-input" {% if te_product_status %}checked="checked"{% endif %}> {{ entry_table_product_status_filter }}<br><br>
                  <input type="checkbox" id="te-analization-product-quantity-filter" value="1" class="form-check-input" {% if te_product_quantity %}checked="checked"{% endif %}> {{ entry_table_product_quantity_filter }}<br><br>
                  <label class="form-label" for="te-analization-product-category-id-filter">{{ entry_table_product_category_id_filter }}</label>
                  <div class="mb-1"><button type="button" class="btn btn-outline-secondary btn-sm te-multi-select-all" data-te-target="#te-analization-product-category-id-filter" data-te-caption-first="{{ button_select_first|e('html_attr') }}">{{ button_select_all }}</button> <button type="button" class="btn btn-outline-secondary btn-sm te-multi-select-clear" data-te-target="#te-analization-product-category-id-filter">{{ button_clear_selection }}</button></div>
                  <select id="te-analization-product-category-id-filter" data-te-max="{{ te_multi_select_max }}" multiple="multiple" size="6" class="form-select mb-2">
                    {% for category in categories %}
                    <option value="{{ category.category_id }}" {% if category.category_id in te_product_category_id %}selected="selected"{% endif %}>{{ category.name }}</option>
                    {% endfor %}
                  </select>
                  <div class="form-text">{{ help_multi_select }}</div><div class="form-text te-multi-select-limit" style="display:none">{{ help_multi_select_limit }}</div><br>
                  <label class="form-label" for="te-analization-product-stock-status-filter">{{ entry_table_product_stock_status_filter }}</label>
                  <div class="mb-1"><button type="button" class="btn btn-outline-secondary btn-sm te-multi-select-all" data-te-target="#te-analization-product-stock-status-filter" data-te-caption-first="{{ button_select_first|e('html_attr') }}">{{ button_select_all }}</button> <button type="button" class="btn btn-outline-secondary btn-sm te-multi-select-clear" data-te-target="#te-analization-product-stock-status-filter">{{ button_clear_selection }}</button></div>
                  <select id="te-analization-product-stock-status-filter" data-te-max="{{ te_multi_select_max }}" multiple="multiple" size="6" class="form-select mb-2">
                    {% for stock_status in stock_statuses %}
                    <option value="{{ stock_status.stock_status_id }}" {% if stock_status.stock_status_id in te_stock_status %}selected="selected"{% endif %}>{{ stock_status.name }}</option>
                    {% endfor %}
                  </select>
                  <div class="form-text">{{ help_multi_select }}</div><div class="form-text te-multi-select-limit" style="display:none">{{ help_multi_select_limit }}</div><br>
                  <label class="form-label" for="te-analization-product-manufacturer-filter">{{ entry_table_product_manufacturer_filter }}</label>
                  <div class="mb-1"><button type="button" class="btn btn-outline-secondary btn-sm te-multi-select-all" data-te-target="#te-analization-product-manufacturer-filter" data-te-caption-first="{{ button_select_first|e('html_attr') }}">{{ button_select_all }}</button> <button type="button" class="btn btn-outline-secondary btn-sm te-multi-select-clear" data-te-target="#te-analization-product-manufacturer-filter">{{ button_clear_selection }}</button></div>
                  <select id="te-analization-product-manufacturer-filter" data-te-max="{{ te_multi_select_max }}" multiple="multiple" size="6" class="form-select mb-2">
                    {% for manufacturer in manufacturers %}
                    <option value="{{ manufacturer.manufacturer_id }}" {% if manufacturer.manufacturer_id in te_manufacturer_id %}selected="selected"{% endif %}>{{ manufacturer.name }}</option>
                    {% endfor %}
                  </select>
                  <div class="form-text">{{ help_multi_select }}</div><div class="form-text te-multi-select-limit" style="display:none">{{ help_multi_select_limit }}</div><br>
                </div>
              </div>

              <div class="mb-3 row" id="te-cron-link-panel" data-cron-url="{{ te_cron_url|e('html_attr') }}" data-te-max-length="{{ te_cron_link_max_length }}">
                <label class="col-sm-2 form-label" for="te-cron-link">{{ entry_cron_link }}</label>
                <div class="col-sm-10">
                  <input type="text" readonly="readonly" id="te-cron-link" class="form-control" value=""{% if not te_cron_secret_valid %} style="display:none"{% endif %} />
                  <div class="form-text" id="te-cron-link-help"{% if not te_cron_secret_valid %} style="display:none"{% endif %}>{{ help_cron_link }}</div>
                  <div class="text-danger" id="te-cron-link-error"{% if te_cron_secret_valid %} style="display:none"{% endif %}>{{ error_cron_secret }}</div>
                  <div class="text-warning" id="te-cron-link-long" style="display:none">{{ warning_cron_link_long }}</div>
                </div>
              </div>

              <div class="mb-3 row">
                <label class="col-sm-2 form-label" for="te-begin-analization">{{ entry_analization }}</label>
                <div class="col-sm-10">
                  <input type="button" id="te-begin-analization" value="{{ entity_begin_analization }}" class="btn btn-primary">
                </div>
              </div>
              <div class="mb-3 row">
                <label class="col-sm-2 form-label" for="te-remove-translation" style="color:red">{{ entry_remove_translation_records_from_db }}</label>
                <div class="col-sm-10">
                  <input type="button" id="te-begin-removing_data_from_db" value="{{ entity_begin_removing_data_from_db }}" class="btn btn-danger">
                </div>
              </div>
              <div class="mb-3 row">
                <label class="col-sm-2 form-label" for="input-client_translate_expert_status">{{ entry_analization_result }}</label>
                <div class="col-sm-10">
                  <div id="te-analization-result">
                  </div>
                </div>
              </div>
            </div>




            <div class="tab-pane" id="tab-localization">
              <div class="mb-3 row">
                <label class="col-sm-2 form-label" for="te-localization-language-from">{{ entry_localization_language_from }}</label>
                <div class="col-sm-10">
                  <select id="te-localization-language-from" class="form-select">
                    {% for language in languages %}
                    <option value="{{ language.language_id }}" {% if te_langIdFrom == language.language_id %}selected="selected"{% endif %}>{{ language.name }}</option>
                    {% endfor %}
                  </select>
                </div>
              </div>
              <div class="mb-3 row">
                <label class="col-sm-2 form-label" for="te-localization-language-to">{{ entry_localization_language_to }}</label>
                <div class="col-sm-10">
                  <select id="te-localization-language-to" class="form-select">
                    {% for language in languages %}
                    <option value="{{ language.language_id }}" {% if (te_langIdTo is empty and loop.index0 == 1) or (te_langIdTo is not empty and te_langIdTo == language.language_id) %}selected="selected"{% endif %}>{{ language.name }}</option>
                    {% endfor %}
                  </select>
                </div>
              </div>
              <div class="mb-3 row">
                <label class="col-sm-2 form-label" for="te-begin-localization-analization">{{ entry_localization_analization }}</label>
                <div class="col-sm-10">
                  <input type="button" id="te-begin-localization-analization" value="{{ entity_begin_analization }}" class="btn btn-primary">
                </div>
              </div>
              <div class="mb-3 row">
                <label class="col-sm-2 form-label" for="te-localization-analization-result">{{ entry_localization_analization_result }}</label>
                <div class="col-sm-10">
                  <div id="te-localization-analization-result" data-scope="catalog">
                  </div>
                </div>
              </div>
            </div>


            <div class="tab-pane" id="tab-admin-localization">
              <div class="mb-3 row">
                <label class="col-sm-2 form-label" for="te-admin-localization-language-from">{{ entry_localization_language_from }}</label>
                <div class="col-sm-10">
                  <select id="te-admin-localization-language-from" class="form-select">
                    {% for language in languages %}
                    <option value="{{ language.language_id }}" {% if te_langIdFrom == language.language_id %}selected="selected"{% endif %}>{{ language.name }}</option>
                    {% endfor %}
                  </select>
                </div>
              </div>
              <div class="mb-3 row">
                <label class="col-sm-2 form-label" for="te-admin-localization-language-to">{{ entry_localization_language_to }}</label>
                <div class="col-sm-10">
                  <select id="te-admin-localization-language-to" class="form-select">
                    {% for language in languages %}
                    <option value="{{ language.language_id }}" {% if (te_langIdTo is empty and loop.index0 == 1) or (te_langIdTo is not empty and te_langIdTo == language.language_id) %}selected="selected"{% endif %}>{{ language.name }}</option>
                    {% endfor %}
                  </select>
                </div>
              </div>
              <div class="mb-3 row">
                <label class="col-sm-2 form-label" for="te-begin-admin-localization-analization">{{ entry_localization_analization }}</label>
                <div class="col-sm-10">
                  <input type="button" id="te-begin-admin-localization-analization" value="{{ entity_begin_analization }}" class="btn btn-primary">
                </div>
              </div>
              <div class="mb-3 row">
                <label class="col-sm-2 form-label" for="te-admin-localization-analization-result">{{ entry_localization_analization_result }}</label>
                <div class="col-sm-10">
                  <div id="te-admin-localization-analization-result" data-scope="admin">
                  </div>
                </div>
              </div>
            </div>




            <div class="tab-pane {{ tab_debug_class }}" id="tab-debug">
              <div class="mb-3 row">
                <label class="col-sm-2 form-label" for="client_translate_expert_version">{{ entry_translate_expert_version }}</label>
                <div class="col-sm-10">
                  <strong name="client_translate_expert_version" id="client_translate_expert_version" class="form-control">{{ translate_expert_version }}</strong>
                </div>
              </div>
              <div class="mb-3 row">
                <label class="col-sm-2 form-label" for="php_version">{{ entry_php_version }}</label>
                <div class="col-sm-10">
                  <strong name="php_version" id="php_version" class="form-control">{{ php_version }}</strong>
                </div>
              </div>
              <div class="mb-3 row">
                <label class="col-sm-2 form-label" for="opencart_version">{{ entry_opencart_version }}</label>
                <div class="col-sm-10">
                  <strong name="opencart_version" id="opencart_version" class="form-control">{{ opencart_version }}</strong>
                </div>
              </div>
              <div class="mb-3 row">
                <label class="col-sm-2 form-label" for="reset_translation_cache">{{ entry_reset_translation_cache }}</label>
                <div class="col-sm-10">
                  <div class="btn btn-primary" name="reset_translation_cache" id="reset_translation_cache" title="{{ entry_reset_translation_cache }}" onclick="resetTranslationCache()">{{ entry_reset_translation_cache }}</div>
                </div>
              </div>
              <div class="mb-3 row">
                <label class="col-sm-2 form-label">{{ entry_debug_status }}</label>
                <div class="col-sm-10">
                  <div class="btn-group" role="group">
                    <input type="radio" class="btn-check" name="client_translate_expert_debug_status" value="1" id="debug-status-enabled" autocomplete="off" {% if client_translate_expert_debug_status %}checked="checked"{% endif %}>
                    <label class="btn btn-primary" for="debug-status-enabled">{{ text_enabled }}</label>
                    <input type="radio" class="btn-check" name="client_translate_expert_debug_status" value="0" id="debug-status-disabled" autocomplete="off" {% if not client_translate_expert_debug_status %}checked="checked"{% endif %}>
                    <label class="btn btn-primary" for="debug-status-disabled">{{ text_disabled }}</label>
                  </div>
                </div>
              </div>

              <div class="card">
                <div class="container-fluid">
                  <div class="float-start">
                    {% if debug_log is defined %}
                    <a href="{{ download_href }}" data-bs-toggle="tooltip" title="{{ button_download }}" class="btn btn-primary"><i class="fa fa-download"></i></a>
                    <a onclick="confirm('{{ text_clear_confirm }}') ? location.href='{{ clear_href }}' : false;" data-bs-toggle="tooltip" title="{{ button_clear }}" class="btn btn-danger"><i class="fa fa-eraser"></i></a>
                    {% else %}
                    <a class="btn btn-info" href="{{ view_href }}" data-bs-toggle="tooltip" title="{{ button_view }}"><i class="fa fa-eye"> {{ button_view }}</i></a>
                    {% endif %}
                  </div>
                </div>
                <div class="container-fluid">
                  <div class="card-header">
                    <h3 class="card-title"><i class="fa fa-exclamation-triangle"></i> {{ text_debug_log }}</h3>
                  </div>
                </div>
                {% if debug_log is defined %}
                  {% if error_debug_log_warning_frm is defined and error_debug_log_warning_frm %}
                  <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_debug_log_warning_frm }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                  </div>
                  {% endif %}
                  <div class="card-body">
                    <textarea wrap="off" rows="30" readonly class="form-control">{{ debug_log }}</textarea>
                  </div>
                {% endif %}
              </div>

            </div>
            <div class="tab-pane" id="tab-about">
              {{ text_about_page|raw }}
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
