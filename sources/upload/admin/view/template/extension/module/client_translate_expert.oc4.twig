      </div>
    </div>
  </div>
</div>
<!-- js constants -->
<script>
	document.js_const_done_status = "{{ js_const_done_status|raw }}";
	document.js_const_in_progress_status = "{{ js_const_in_progress_status|raw }}";
	document.js_const_statistic_html = "{{ js_const_statistic_html|replace({"\n": "", "\r": ""})|raw }}";
	document.js_const_analization_process_is_started = "{{ js_const_analization_process_is_started|raw }}";
	// removing
	document.js_const_entry_remove_translation_records_from_db_confirmation = "{{ entry_remove_translation_records_from_db_confirmation }}";
	document.js_const_entry_removing_data_from_db_process_is_started = "{{ entry_removing_data_from_db_process_is_started }}";

	// The key input is a text input masked with CSS, so password managers do not suggest or save a password for it.
	// If the browser does not support -webkit-text-security, fall back to a password input.
	(function() {
		var input = document.getElementById('input-client_translate_expert_key');
		var cssMask = !!(window.CSS && CSS.supports && CSS.supports('-webkit-text-security', 'disc'));
		if (!cssMask) {
			input.type = 'password';
		}
		$('#button-client_translate_expert_key_toggle').on('click', function() {
			var show = cssMask ? $(input).hasClass('te-key-masked') : input.type === 'password';
			if (cssMask) {
				$(input).toggleClass('te-key-masked', !show);
			} else {
				input.type = show ? 'text' : 'password';
			}
			$(this).text($(this).data(show ? 'text-hide' : 'text-show'));
		});
	})();

	$('#te-analization-language-to').change();
</script>
{{ footer }}