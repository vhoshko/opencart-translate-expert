{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-bestseller" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-bs-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-secondary"><i class="fa fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    {% endif %}
    <div class="te-app" id="te-app">
      <div class="te-alerts" id="te-summary-alerts"></div>
      <div class="te-summary" id="te-summary">
        <span class="te-summary__item">{{ te_summary_status }}: <span class="te-badge {% if te_summary_status_on %}te-badge--ok{% else %}te-badge--muted{% endif %}">{% if te_summary_status_on %}{{ te_summary_enabled }}{% else %}{{ te_summary_disabled }}{% endif %}</span></span>
        <span class="te-summary__item">{{ te_summary_api_key }}: <span class="te-badge {% if te_summary_key_set_on %}te-badge--ok{% else %}te-badge--error{% endif %}">{% if te_summary_key_set_on %}{{ te_summary_key_set }}{% else %}{{ te_summary_key_not_set }}{% endif %}</span></span>
        <div class="te-summary__meter" id="te-summary-count"></div>
      </div>
    </div>
    <div class="card">
      <div class="card-header">
        <h3 class="card-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="card-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-bestseller">
          <ul class="nav nav-tabs">
            <li class="nav-item"><a href="#tab-general" class="nav-link {{ tab_general_class }}" data-bs-toggle="tab">{{ tab_general }}</a></li>
            <li class="nav-item"><a href="#tab-translate-site" class="nav-link" data-bs-toggle="tab">{{ tab_translate_site }}</a></li>
            <li class="nav-item"><a href="#tab-localization" class="nav-link" data-bs-toggle="tab">{{ tab_localization }}</a></li>
            <li class="nav-item"><a href="#tab-admin-localization" class="nav-link" data-bs-toggle="tab">{{ tab_admin_localization }}</a></li>
            <li class="nav-item"><a href="#tab-debug" class="nav-link {{ tab_debug_class }}" data-bs-toggle="tab">{{ tab_debug }}</a></li>
            <li class="nav-item"><a href="#tab-about" class="nav-link" data-bs-toggle="tab">{{ tab_about }}</a></li>
          </ul>

          <div class="te-app te-langbar-wrap" id="te-langbar-app">
            <div class="te-langbar te-hidden">
              <label for="te-langbar-from">{{ te_site_lang_from }}</label>
              <select id="te-langbar-from" class="form-select te-langbar__select">
                {% for language in languages %}
                <option value="{{ language.language_id }}" {% if te_langIdFrom == language.language_id %}selected="selected"{% endif %}>{{ language.name }}</option>
                {% endfor %}
              </select>
              <button type="button" class="btn btn-outline-secondary te-js-langbar-swap" title="{{ te_site_lang_swap|e('html_attr') }}" aria-label="{{ te_site_lang_swap|e('html_attr') }}"><i class="fa-solid fa-right-left" aria-hidden="true"></i></button>
              <label for="te-langbar-to">{{ te_site_lang_to }}</label>
              <select id="te-langbar-to" class="form-select te-langbar__select">
                {% for language in languages %}
                <option value="{{ language.language_id }}" {% if (te_langIdTo is empty and loop.index0 == 1) or (te_langIdTo is not empty and te_langIdTo == language.language_id) %}selected="selected"{% endif %}>{{ language.name }}</option>
                {% endfor %}
              </select>
            </div>
          </div>

          <div class="tab-content">
            <div class="tab-pane {{ tab_general_class }}" id="tab-general">
              <div class="te-app" id="te-settings-app">
                <div class="te-card">
                  <div class="te-card__head">{{ te_settings_card_connection }}</div>
                  <div class="te-card__body">
                    <div class="te-form">
                      <div class="te-field">
                        <label class="te-field__label" for="input-client_translate_expert_status">{{ entry_status }}</label>
                        <div class="te-field__control"><select name="client_translate_expert_status" id="input-client_translate_expert_status" class="form-select">
                        {% if client_translate_expert_status %}
                                              <option value="1" selected="selected">{{ text_enabled }}</option>
                                              <option value="0">{{ text_disabled }}</option>
                                              {% else %}
                                              <option value="1">{{ text_enabled }}</option>
                                              <option value="0" selected="selected">{{ text_disabled }}</option>
                                              {% endif %}
                      </select></div>
                      </div>
                      <div class="te-field">
                        <label class="te-field__label" for="input-client_translate_expert_key">{{ entry_server_key }}</label>
                        <div class="te-field__control"><style>.te-key-masked { -webkit-text-security: disc; }</style>
                      <div class="input-group">
                        <input type="text" autocomplete="off" spellcheck="false" data-lpignore="true" data-1p-ignore="true" data-bwignore="true" data-form-type="other" name="client_translate_expert_key" value="{{ client_translate_expert_key }}" placeholder="{{ entry_server_key }}" id="input-client_translate_expert_key" class="form-control te-key-masked" />
                        <button type="button" id="button-client_translate_expert_key_toggle" class="btn btn-outline-secondary" data-text-show="{{ button_show_key }}" data-text-hide="{{ button_hide_key }}">{{ button_show_key }}</button>
                      </div></div>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="te-card">
                  <div class="te-card__head">{{ te_settings_card_usage }}</div>
                  <div class="te-card__body">
                    <div class="te-form">
                      <div class="te-field">
                        <span class="te-field__label">{{ entry_server_translation_char_count }}</span>
                        <div class="te-field__control"><div id="input-client_translate_expert_char_count">{{ client_translate_expert_char_count ? client_translate_expert_char_count : 0 }}</div></div>
                      </div>
                      <div class="te-field">
                        <span class="te-field__label"></span>
                        <div class="te-field__control"><div class="form-check"><input type="checkbox" name="client_translate_expert_show_char_count_globally" value="1" id="input-client_translate_expert_show_char_count_globally" class="form-check-input" {% if client_translate_expert_show_char_count_globally == 1 %}checked="checked"{% endif %}/> <label class="form-check-label" for="input-client_translate_expert_show_char_count_globally">{{ entry_server_show_translation_char_count_globally }}</label></div></div>
                      </div>
                      <div class="te-field">
                        <span class="te-field__label"></span>
                        <div class="te-field__control"><div class="form-check"><input type="checkbox" name="client_translate_expert_reset_char_count_on_start_month" value="1" id="input-client_translate_expert_reset_char_count_on_start_month" class="form-check-input" {% if client_translate_expert_reset_char_count_on_start_month == 1 %}checked="checked"{% endif %}/> <label class="form-check-label" for="input-client_translate_expert_reset_char_count_on_start_month">{{ entry_server_reset_translation_char_count_on_start_month }}</label></div></div>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="te-card">
                  <div class="te-card__head">
                    <button type="button" class="te-collapse-toggle te-js-collapse" data-te-target="#te-cron-panel" aria-expanded="false" aria-controls="te-cron-panel">{{ te_settings_card_cron }}</button>
                  </div>
                  <div class="te-card__body te-hidden" id="te-cron-panel">
                    <div class="te-form">
                      <div class="te-field">
                        <label class="te-field__label" for="te-cron-bulk-amount">{{ entry_cron_bulk_amount }}</label>
                        <div class="te-field__control"><input type="number" min="1" max="100000" step="1" name="client_translate_expert_cron_bulk_amount" value="{{ client_translate_expert_cron_bulk_amount|e('html_attr') }}" id="te-cron-bulk-amount" class="form-control" /></div>
                        <div class="te-field__help">{{ help_cron_bulk_amount }}</div>
                      </div>
                      <div class="te-field">
                        <label class="te-field__label" for="te-cron-secret">{{ entry_cron_secret }}</label>
                        <div class="te-field__control"><div class="input-group">
                        <input type="text" autocomplete="off" spellcheck="false" data-lpignore="true" data-1p-ignore="true" data-bwignore="true" data-form-type="other" maxlength="128" name="client_translate_expert_cron_secret" value="{{ client_translate_expert_cron_secret|e('html_attr') }}" placeholder="{{ entry_cron_secret }}" id="te-cron-secret" class="form-control" />
                        <button type="button" id="te-cron-secret-generate" class="btn btn-outline-secondary">{{ button_cron_secret_generate }}</button>
                      </div>
                      <div class="text-warning" id="te-cron-secret-unsaved" style="display:none">{{ text_cron_secret_unsaved }}</div></div>
                        <div class="te-field__help">{{ help_cron_secret }}</div>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="te-card">
                  <div class="te-card__head">
                    <button type="button" class="te-collapse-toggle te-js-collapse" data-te-target="#te-routes-panel" aria-expanded="false" aria-controls="te-routes-panel">{{ te_settings_card_routes }}</button>
                  </div>
                  <div class="te-card__body te-hidden" id="te-routes-panel">
                    <div class="te-form">
                      <div class="te-field">
                        <label class="te-field__label" for="input-client_translate_expert_excluded_routes">{{ entry_excluded_routes }}</label>
                        <div class="te-field__control"><textarea name="client_translate_expert_excluded_routes" rows="5" id="input-client_translate_expert_excluded_routes" class="form-control">{{ client_translate_expert_excluded_routes }}</textarea></div>
                        <div class="te-field__help">{{ help_excluded_routes }}</div>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="te-card">
                  <div class="te-card__head">
                    <button type="button" class="te-collapse-toggle te-js-collapse" data-te-target="#te-lcm-panel" aria-expanded="{% if error_language_code_map %}true{% else %}false{% endif %}" aria-controls="te-lcm-panel">{{ te_settings_card_language_codes }}</button>
                  </div>
                  <div class="te-card__body{% if not error_language_code_map %} te-hidden{% endif %}" id="te-lcm-panel">
                    <div class="te-alerts" id="te-lcm-alerts"></div>
                    <div class="te-form">
                      <div class="te-field">
                        <div class="te-field__label" id="te-lcm-label">{{ entry_language_code_map }}</div>
                        <div class="te-field__control">
                          <input type="hidden" name="client_translate_expert_language_code_map" id="input-client_translate_expert_language_code_map" value="{{ client_translate_expert_language_code_map|escape('html_attr') }}" data-te-default="{{ te_language_code_map_default|escape('html_attr') }}" />
                          <div class="te-lcm-head"><span>{{ te_lcm_col_key }}</span><span>{{ te_lcm_col_value }}</span><span class="te-lcm-head__gap"></span></div>
                          <div id="te-lcm-rows" role="group" aria-labelledby="te-lcm-label" data-te-delete="{{ te_lcm_delete|escape('html_attr') }}"></div>
                          <div class="te-field__help te-hidden" id="te-lcm-empty">{{ te_lcm_empty }}</div>
                          <div class="te-lcm-actions">
                            <button type="button" id="te-lcm-add" class="btn btn-outline-secondary">{{ te_lcm_add }}</button>
                            <button type="button" id="te-lcm-reset" class="btn btn-outline-secondary">{{ te_lcm_reset }}</button>
                          </div>
                        </div>
                        <div class="te-field__help">{{ help_language_code_map }}</div>
                        {% if error_language_code_map %}<div class="text-danger te-field__error">{{ error_language_code_map }}</div>{% endif %}
                      </div>
                    </div>
                  </div>
                </div>
                <div class="te-card">
                  <div class="te-card__head">
                    <button type="button" class="te-collapse-toggle te-js-collapse" data-te-target="#te-try-panel" aria-expanded="false" aria-controls="te-try-panel">{{ te_settings_card_try }}</button>
                  </div>
                  <div class="te-card__body te-hidden" id="te-try-panel">
                    {% for language in languages %}
                    <div class="input-group" style="margin-bottom: 8px;">
                      <span class="input-group-text"><img src="{{ language.image_url }}" title="{{ language.name }}" /></span>
                      <textarea name="test[{{ language.language_id }}][translation]" rows="7" placeholder="{{ entry_try_translate_text }}" class="form-control"></textarea>
                    </div>
                    {% endfor %}
                  </div>
                </div>
              </div>
            </div>
            <div class="tab-pane" id="tab-translate-site">
              {% set te_mode_value = te_mode in ['only_empty', 'same_value'] ? te_mode : 'both' %}
              <div class="te-app" id="te-site-app">
                <div class="te-alerts" id="te-site-alerts"></div>
                <div class="te-card">
                  <div class="te-card__head">{{ te_site_card_what }}</div>
                  <div class="te-card__body">
                    <div class="te-form">
                      <div class="te-field">
                        <span class="te-field__label">{{ entry_analization_mode }}</span>
                        <div class="te-field__control te-radio-group">
                          <div class="form-check form-check-inline"><input type="radio" class="form-check-input" name="te-analization-mode" form="te-no-form" id="te-analization-mode-both" value="both" {% if te_mode_value == 'both' %}checked="checked"{% endif %}> <label class="form-check-label" for="te-analization-mode-both">{{ value_analization_mode_both }}</label></div>
                          <div class="form-check form-check-inline"><input type="radio" class="form-check-input" name="te-analization-mode" form="te-no-form" id="te-analization-mode-only-empty" value="only_empty" {% if te_mode_value == 'only_empty' %}checked="checked"{% endif %}> <label class="form-check-label" for="te-analization-mode-only-empty">{{ value_analization_mode_only_empty }}</label></div>
                          <div class="form-check form-check-inline"><input type="radio" class="form-check-input" name="te-analization-mode" form="te-no-form" id="te-analization-mode-same-value" value="same_value" {% if te_mode_value == 'same_value' %}checked="checked"{% endif %}> <label class="form-check-label" for="te-analization-mode-same-value">{{ value_analization_mode_same_value }}</label></div>
                        </div>
                      </div>
                      <div class="te-field">
                        <label class="te-field__label" for="te-analization-table">{{ entry_table }}</label>
                        <div class="te-field__control">
                          <div class="mb-1"><button type="button" class="btn btn-outline-secondary btn-sm te-multi-select-all" data-te-target="#te-analization-table" data-te-caption-first="{{ button_select_first|e('html_attr') }}">{{ button_select_all }}</button> <button type="button" class="btn btn-outline-secondary btn-sm te-multi-select-clear" data-te-target="#te-analization-table">{{ button_clear_selection }}</button></div>
                          <select id="te-analization-table" data-te-max="{{ te_multi_select_max }}" multiple="multiple" size="6" class="form-select">
                            {% for table in tables %}
                            <option value="{{ table }}" {% if table in te_table %}selected="selected"{% endif %}>{{ table }}</option>
                            {% endfor %}
                          </select>
                          <div class="form-text">{{ help_multi_select }}</div><div class="form-text te-multi-select-limit" style="display:none">{{ help_multi_select_limit }}</div>
                        </div>
                      </div>
                      <div class="te-field">
                        <label class="te-field__label" for="te-analization-table-deep">{{ entry_table_deep }}</label>
                        <div class="te-field__control">
                          <div class="form-check"><input type="checkbox" id="te-analization-table-deep" value="1" checked="checked" class="form-check-input"> <label class="form-check-label" for="te-analization-table-deep">{{ entry_table_deep_description }}</label></div>
                        </div>
                      </div>
                      <div class="te-field">
                        <span class="te-field__label"></span>
                        <div class="te-field__control">
                          <button type="button" class="te-collapse-toggle te-js-collapse" data-te-target="#te-site-more-filters" aria-expanded="false" aria-controls="te-site-more-filters">{{ te_site_more_filters }}</button>
                        </div>
                      </div>
                      <div class="te-form te-hidden" id="te-site-more-filters">
                        <div class="te-field">
                          <span class="te-field__label">{{ entry_table_product_filter }}</span>
                          <div class="te-field__control">
                            <div class="form-check"><input type="checkbox" id="te-analization-product-status-filter" value="1" class="form-check-input" {% if te_product_status %}checked="checked"{% endif %}> <label class="form-check-label" for="te-analization-product-status-filter">{{ entry_table_product_status_filter }}</label></div>
                            <div class="form-check"><input type="checkbox" id="te-analization-product-quantity-filter" value="1" class="form-check-input" {% if te_product_quantity %}checked="checked"{% endif %}> <label class="form-check-label" for="te-analization-product-quantity-filter">{{ entry_table_product_quantity_filter }}</label></div>
                          </div>
                        </div>
                        <div class="te-field">
                          <label class="te-field__label" for="te-analization-product-category-id-filter">{{ entry_table_product_category_id_filter }}</label>
                          <div class="te-field__control">
                            <div class="mb-1"><button type="button" class="btn btn-outline-secondary btn-sm te-multi-select-all" data-te-target="#te-analization-product-category-id-filter" data-te-caption-first="{{ button_select_first|e('html_attr') }}">{{ button_select_all }}</button> <button type="button" class="btn btn-outline-secondary btn-sm te-multi-select-clear" data-te-target="#te-analization-product-category-id-filter">{{ button_clear_selection }}</button></div>
                            <select id="te-analization-product-category-id-filter" data-te-max="{{ te_multi_select_max }}" multiple="multiple" size="6" class="form-select mb-2">
                              {% for category in categories %}
                              <option value="{{ category.category_id }}" {% if category.category_id in te_product_category_id %}selected="selected"{% endif %}>{{ category.name }}</option>
                              {% endfor %}
                            </select>
                            <div class="form-text">{{ help_multi_select }}</div><div class="form-text te-multi-select-limit" style="display:none">{{ help_multi_select_limit }}</div>
                          </div>
                        </div>
                        <div class="te-field">
                          <label class="te-field__label" for="te-analization-product-stock-status-filter">{{ entry_table_product_stock_status_filter }}</label>
                          <div class="te-field__control">
                            <div class="mb-1"><button type="button" class="btn btn-outline-secondary btn-sm te-multi-select-all" data-te-target="#te-analization-product-stock-status-filter" data-te-caption-first="{{ button_select_first|e('html_attr') }}">{{ button_select_all }}</button> <button type="button" class="btn btn-outline-secondary btn-sm te-multi-select-clear" data-te-target="#te-analization-product-stock-status-filter">{{ button_clear_selection }}</button></div>
                            <select id="te-analization-product-stock-status-filter" data-te-max="{{ te_multi_select_max }}" multiple="multiple" size="6" class="form-select mb-2">
                              {% for stock_status in stock_statuses %}
                              <option value="{{ stock_status.stock_status_id }}" {% if stock_status.stock_status_id in te_stock_status %}selected="selected"{% endif %}>{{ stock_status.name }}</option>
                              {% endfor %}
                            </select>
                            <div class="form-text">{{ help_multi_select }}</div><div class="form-text te-multi-select-limit" style="display:none">{{ help_multi_select_limit }}</div>
                          </div>
                        </div>
                        <div class="te-field">
                          <label class="te-field__label" for="te-analization-product-manufacturer-filter">{{ entry_table_product_manufacturer_filter }}</label>
                          <div class="te-field__control">
                            <div class="mb-1"><button type="button" class="btn btn-outline-secondary btn-sm te-multi-select-all" data-te-target="#te-analization-product-manufacturer-filter" data-te-caption-first="{{ button_select_first|e('html_attr') }}">{{ button_select_all }}</button> <button type="button" class="btn btn-outline-secondary btn-sm te-multi-select-clear" data-te-target="#te-analization-product-manufacturer-filter">{{ button_clear_selection }}</button></div>
                            <select id="te-analization-product-manufacturer-filter" data-te-max="{{ te_multi_select_max }}" multiple="multiple" size="6" class="form-select mb-2">
                              {% for manufacturer in manufacturers %}
                              <option value="{{ manufacturer.manufacturer_id }}" {% if manufacturer.manufacturer_id in te_manufacturer_id %}selected="selected"{% endif %}>{{ manufacturer.name }}</option>
                              {% endfor %}
                            </select>
                            <div class="form-text">{{ help_multi_select }}</div><div class="form-text te-multi-select-limit" style="display:none">{{ help_multi_select_limit }}</div>
                          </div>
                        </div>
                      </div>
                    </div>
                    <div class="te-toolbar">
                      <button type="button" id="te-begin-analization" class="btn btn-primary" title="{{ entry_analization|e('html_attr') }}">{{ entity_begin_analization }}</button>
                      <span class="te-toolbar__spacer"></span>
                      <button type="button" id="te-begin-removing_data_from_db" class="btn btn-danger" data-te-label="{{ entity_begin_removing_data_from_db|e('html_attr') }}" title="{{ entry_remove_translation_records_from_db|e('html_attr') }}">{{ entity_begin_removing_data_from_db }}</button>
                    </div>
                  </div>
                </div>
                <div class="te-card">
                  <div class="te-card__head">
                    <button type="button" class="te-collapse-toggle te-js-collapse" data-te-target="#te-cron-link-panel" aria-expanded="false" aria-controls="te-cron-link-panel">{{ entry_cron_link }}</button>
                  </div>
                  <div class="te-card__body te-hidden" id="te-cron-link-panel" data-cron-url="{{ te_cron_url|e('html_attr') }}" data-te-max-length="{{ te_cron_link_max_length }}">
                    <input type="text" readonly="readonly" id="te-cron-link" class="form-control" value=""{% if not te_cron_secret_valid %} style="display:none"{% endif %} />
                    <div class="form-text" id="te-cron-link-help"{% if not te_cron_secret_valid %} style="display:none"{% endif %}>{{ help_cron_link }}</div>
                    <div class="text-danger" id="te-cron-link-error"{% if te_cron_secret_valid %} style="display:none"{% endif %}>{{ error_cron_secret }}</div>
                    <div class="text-warning" id="te-cron-link-long" style="display:none">{{ warning_cron_link_long }}</div>
                  </div>
                </div>
                <div class="te-progress te-hidden" id="te-site-progress" role="status" aria-live="polite"></div>
                <div id="te-analization-result"></div>
              </div>
            </div>




            <div class="tab-pane" id="tab-localization">
              <div class="te-app te-loc-app" id="te-loc-app-catalog" data-scope="catalog">
                <div class="te-alerts" id="te-loc-alerts-catalog"></div>
                <div class="te-card">
                  <div class="te-card__head">{{ te_loc_card_files }}</div>
                  <div class="te-card__body">
                    <div class="te-loc-totals te-hidden" id="te-loc-totals-catalog"></div>
                    <div class="te-toolbar">
                      <button type="button" id="te-begin-localization-analization" class="btn btn-primary te-js-loc-analyze">{{ te_loc_analyze }}</button>
                    </div>
                  </div>
                </div>
                <div class="te-progress te-hidden" id="te-loc-progress-catalog" role="status" aria-live="polite"></div>
                <div class="te-loc-result" id="te-loc-result-catalog"></div>
              </div>
